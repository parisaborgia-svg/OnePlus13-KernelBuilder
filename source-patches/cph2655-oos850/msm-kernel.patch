diff --git a/include/linux/soc/qcom/msm_adreno_devfreq.h b/include/linux/soc/qcom/msm_adreno_devfreq.h
index 53f99c6d11eaf1d6d024d02b8a8c35d75fc914a1..df8ed8f8b9dada5e93835902da3b96663805029a 100644
--- a/include/linux/soc/qcom/msm_adreno_devfreq.h
+++ b/include/linux/soc/qcom/msm_adreno_devfreq.h
@@ -78,11 +78,24 @@ typedef void(*getbw_func)(unsigned long *, unsigned long *, void *);
 
 #if IS_ENABLED(CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ)
 int msm_adreno_tz_reinit(struct devfreq *devfreq);
+/*
+ * adreno_sysfs.c (KERNEL_VERSION >= 6.3) calls this, but this source pull's
+ * governor_msm_adreno_tz.c never declared or defined it. Stubbed there to return
+ * -EOPNOTSUPP, matching what adreno_sysfs.c's own pre-6.3 #else branch already does.
+ * NOTE: this global header and graphics-kernel/msm_adreno_devfreq.h share the include
+ * guard MSM_ADRENO_DEVFREQ_H, and kgsl_pwrscale.h includes this one first -- so the
+ * local copy is never processed and declarations MUST go here.
+ */
+int msm_adreno_tz_set_dcvs_boost(struct devfreq *devfreq, bool val);
 #else
 static inline int msm_adreno_tz_reinit(struct devfreq *devfreq)
 {
 	return 0;
 }
+static inline int msm_adreno_tz_set_dcvs_boost(struct devfreq *devfreq, bool val)
+{
+	return -EOPNOTSUPP;
+}
 #endif
 
