diff --git a/include/linux/soc/qcom/panel_event_notifier.h b/include/linux/soc/qcom/panel_event_notifier.h
index a0a17a34a554fe2a2254d764f1ce0ce18f68980c..050bdf61e9b0971ed28cef1937b2c455620e34f0 100755
--- a/include/linux/soc/qcom/panel_event_notifier.h
+++ b/include/linux/soc/qcom/panel_event_notifier.h
@@ -42,6 +42,18 @@ enum panel_event_notifier_client {
 	PANEL_EVENT_NOTIFIER_CLIENT_MM,
 	PANEL_EVENT_NOTIFIER_CLIENT_TRI_STATE_KEY,
 	PANEL_EVENT_NOTIFIER_CLIENT_POGOPIN,
+	/*
+	 * Consumers in the vendor tree reference these but the 850 header predates them:
+	 *   SECONDARY_THEIA_BLACK  -> vendor/oplus/kernel/dfr/common/theia/black_screen_check.c
+	 *   SECONDARY_THEIA_BRIGHT -> vendor/oplus/kernel/dfr/common/theia/bright_screen_check.c
+	 *   TRI_STATE_KEY_FOR_SEC  -> vendor/oplus/kernel/device_info/tri_state_key/oplus_tri_key.c
+	 * Appended here (rather than beside their PRIMARY/base siblings) so that every pre-existing
+	 * enumerator keeps its original numeric value -- stock prebuilt modules that we do not rebuild
+	 * are kept alongside ours and would otherwise disagree about these values.
+	 */
+	PANEL_EVENT_NOTIFIER_CLIENT_SECONDARY_THEIA_BLACK,
+	PANEL_EVENT_NOTIFIER_CLIENT_SECONDARY_THEIA_BRIGHT,
+	PANEL_EVENT_NOTIFIER_CLIENT_TRI_STATE_KEY_FOR_SEC,
 	PANEL_EVENT_NOTIFIER_CLIENT_MAX
 };
 
