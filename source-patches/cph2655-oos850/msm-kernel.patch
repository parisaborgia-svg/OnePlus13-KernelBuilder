index 8ff85211f83bf5ca6ac1910846545623db7b252c..3cd00ff71e353cce3d1428193291a5a760c3c0ac 100755
--- a/drivers/soc/Makefile
+++ b/drivers/soc/Makefile
@@ -37,7 +37,7 @@ obj-$(CONFIG_PLAT_VERSATILE)	+= versatile/
 obj-y				+= xilinx/
 
 #ifdef OPLUS_FEATURE_MM_FEEDBACK
-obj-$(CONFIG_OPLUS_FEATURE_MM_FEEDBACK)	+= oplus/multimedia/
+obj-$(CONFIG_OPLUS_FEATURE_MM_FEEDBACK)	+= oplus/multimedia/common/
 #endif /* OPLUS_FEATURE_MM_FEEDBACK */
 
 #ifdef OPLUS_TRACKPOINT_REPORT
@@ -59,11 +59,20 @@ obj-$(CONFIG_OPLUS_FEATURE_QCOM_WATCHDOG) += oplus/boot/qcom_watchdog/
 
 #ifdef OPLUS_UFS_DRIVER
 obj-$(CONFIG_OPLUS_UFS_DRIVER) += oplus/storage/common/ufs_oplus_dbg/
-obj-$(CONFIG_OPLUS_UFS_DRIVER) += oplus/storage/common/oplus_uprobe/
-obj-$(CONFIG_OPLUS_UFS_DRIVER) += oplus/storage/common/storage_log/
-obj-$(CONFIG_OPLUS_UFS_DRIVER) += oplus/storage/common/oplus_f2fslog_storage/
-obj-$(CONFIG_OPLUS_UFS_DRIVER) += oplus/storage/common/wq_dynamic_priority/
 #endif
+# NOTE: oplus_uprobe/storage_log/oplus_f2fslog_storage/wq_dynamic_priority each
+# have their own independent Kconfig gate (CONFIG_OPLUS_FEATURE_OPLUS_UPROBE,
+# CONFIG_OPLUS_FEATURE_STORAGE_LOG, CONFIG_OPLUS_F2FSLOG_STORAGE,
+# CONFIG_OPLUS_FEATURE_WQ_DYNPRIO respectively) and must NOT be wrapped behind
+# CONFIG_OPLUS_UFS_DRIVER -- doing so silently drops them whenever
+# OPLUS_UFS_DRIVER is disabled (as it is in this defconfig, due to a real bug
+# in ufs_oplus_dbg unrelated to these four), even though their own configs are
+# enabled. Descend unconditionally; each subdirectory's own Makefile applies
+# its own config gate.
+obj-y += oplus/storage/common/oplus_uprobe/
+obj-y += oplus/storage/common/storage_log/
+obj-y += oplus/storage/common/oplus_f2fslog_storage/
+obj-y += oplus/storage/common/wq_dynamic_priority/
 
 #ifdef CONFIG_OPLUS_FEATURE_STORAGE_IO_METRICS
 obj-$(CONFIG_OPLUS_FEATURE_STORAGE_IO_METRICS) += oplus/storage/common/io_metrics/
@@ -74,7 +83,7 @@ obj-y += oplus/dft/
 #endif /* OPLUS_FEATURE_DFT */
 
 #ifdef OPLUS_SUBSYS_SLEEP_MONITOR
-obj-$(CONFIG_OPLUS_SUBSYS_SLEEP_MONITOR)     += oplus/power/subsys_sleep_monitor/
+obj-$(CONFIG_OPLUS_SUBSYS_SLEEP_MONITOR)     += oplus/power/subsys_sleep_monitor/oplus_subsys_sleep_monitor/
 #endif /* OPLUS_SUBSYS_SLEEP_MONITOR */
 
